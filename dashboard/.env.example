# Postgres connection string. For local dev, run `docker compose up -d db`
# in the repo root, or point this at a free Neon/Supabase project for
# deploying the real thing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chief_of_staff?schema=public"

# Shared secret every n8n workflow's final "Send to Dashboard" HTTP node
# must send as `Authorization: Bearer <this value>`. Generate with:
#   openssl rand -hex 32
INGEST_API_KEY="change-me-generate-a-real-secret"

# Password for the single-operator dashboard login. Change this.
DASHBOARD_PASSWORD="change-me"

# Random string used to sign the login session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-real-secret"
